function vLen(a){ return Math.sqrt(vDot(a,a)); }

function fracToCart(frac, va, vb, vc){
  return vAdd(vScale(va,frac[0]), vScale(vb,frac[1]), vScale(vc,frac[2]));
}

function cellVolume(va,vb,vc){ return Math.abs(vDot(va, vCross(vb,vc))); }

// Generates full "raw" atom set for visualization/counting: 8 corners + extra centering atoms
// with their crystallographic weight (contribution fraction).
function fullAtomSet(centering){
  const atoms = [];
  for(let x=0;x<=1;x++) for(let y=0;y<=1;y++) for(let z=0;z<=1;z++){
    atoms.push({frac:[x,y,z], weight:1/8, role:'corner'});
  }
  if(centering==='I'){
    atoms.push({frac:[0.5,0.5,0.5], weight:1, role:'body'});
  } else if(centering==='F'){
    atoms.push({frac:[0.5,0.5,0], weight:0.5, role:'face'});
    atoms.push({frac:[0.5,0.5,1], weight:0.5, role:'face'});
    atoms.push({frac:[0.5,0,0.5], weight:0.5, role:'face'});
    atoms.push({frac:[0.5,1,0.5], weight:0.5, role:'face'});
    atoms.push({frac:[0,0.5,0.5], weight:0.5, role:'face'});
    atoms.push({frac:[1,0.5,0.5], weight:0.5, role:'face'});
  } else if(centering==='C'){
    atoms.push({frac:[0.5,0.5,0], weight:0.5, role:'base'});
    atoms.push({frac:[0.5,0.5,1], weight:0.5, role:'base'});
  }
  return atoms;
}

// Effective atoms per conventional unit cell (standard crystallographic result == offsets.length)
function effectiveAtoms(centering){ return CENTERING_OFFSETS[centering].length; }

// Nearest-neighbour search across periodic images of the point lattice (offsets + integer
// translations of va,vb,vc). This lets us compute Coordination Number and hard-sphere radius
// (for APF) *geometrically and correctly* for ALL 14 lattices, instead of hardcoding values.
function neighborStats(va,vb,vc,centering){
  const offsets = CENTERING_OFFSETS[centering];
  const RANGE = 2;
  let dmin = Infinity;
  const dists = [];
  for(let n1=-RANGE;n1<=RANGE;n1++)
  for(let n2=-RANGE;n2<=RANGE;n2++)
  for(let n3=-RANGE;n3<=RANGE;n3++)
  for(const off of offsets){
    const fx=n1+off[0], fy=n2+off[1], fz=n3+off[2];
    if(Math.abs(fx)<1e-9 && Math.abs(fy)<1e-9 && Math.abs(fz)<1e-9) continue; // skip origin
    const cart = vAdd(vScale(va,fx), vScale(vb,fy), vScale(vc,fz));
    const d = vLen(cart);
    dists.push(d);
    if(d<dmin) dmin=d;
  }
  let cn=0;
  const tol = dmin*1e-3 + 1e-6;
  for(const d of dists){ if(Math.abs(d-dmin)<tol) cn++; }
  return {dmin, cn};
}

function computeAll(params, lat){
  const {a,b,c,alpha,beta,gamma} = params;
  const {va,vb,vc} = latticeVectors(a,b,c,alpha,beta,gamma);
  const V = cellVolume(va,vb,vc);
  const nEff = effectiveAtoms(lat.centering);
  const {dmin, cn} = neighborStats(va,vb,vc,lat.centering);
  const r = dmin/2;
  const apf = V>1e-9 ? (nEff*(4/3)*Math.PI*Math.pow(r,3))/V : 0;
  const atoms = fullAtomSet(lat.centering);
  const cornerCount = atoms.filter(a=>a.role==='corner').length;
  const faceCount = atoms.filter(a=>a.role==='face').length;
  const bodyCount = atoms.filter(a=>a.role==='body').length;
  const baseCount = atoms.filter(a=>a.role==='base').length;
  return {va,vb,vc,V,nEff,dmin,cn,apf,atoms,cornerCount,faceCount,bodyCount,baseCount,r};
}

