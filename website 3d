  const roleColorHex = {corner:'#5ecbd8', face:'#ffb454', body:'#ff8fb1', base:'#c7a3ff'};
  const roleLabel = {corner:'Atom Sudut (1/8)', face:'Atom Muka (1/2)', body:'Atom Badan (1)', base:'Atom Basis (1/2)'};
