function buildQuizBank(){
  const bank = [];
  // System identification from a,b,c / angle relations
  const relSets = [
    {a:'a = b = c', ang:'α = β = γ = 90°', ans:'cubic'},
    {a:'a = b ≠ c', ang:'α = β = γ = 90°', ans:'tetragonal'},
    {a:'a ≠ b ≠ c', ang:'α = β = γ = 90°', ans:'orthorhombic'},
    {a:'a ≠ b ≠ c', ang:'α = γ = 90°, β ≠ 90°', ans:'monoclinic'},
    {a:'a ≠ b ≠ c', ang:'α ≠ β ≠ γ ≠ 90°', ans:'triclinic'},
    {a:'a = b = c', ang:'α = β = γ ≠ 90°', ans:'rhombohedral'},
    {a:'a = b ≠ c', ang:'α = β = 90°, γ = 120°', ans:'hexagonal'}
  ];
  relSets.forEach(r=>{
    const opts = Object.keys(CRYSTAL_SYSTEMS);
    bank.push({
      q:`Suatu unit cell memiliki:\n${r.a}\n${r.ang}\n\nSistem kristalnya adalah?`,
      options: opts, correct:r.ans,
      explain:`Ciri ${r.a} dan ${r.ang} adalah karakteristik unik sistem ${CRYSTAL_SYSTEMS[r.ans].name}.`
    });
  });
  // Effective atom count questions
  BRAVAIS_LATTICES.forEach(l=>{
    const n = effectiveAtoms(l.centering);
    bank.push({
      q:`Berapa jumlah atom efektif per unit cell pada struktur ${l.label} (${l.abbr})?`,
      options:[String(n), String(n+1<=8?n+1:n-1), String(Math.max(1,n-1)), String(n*2)],
      correct:String(n),
      explain:`${l.label} memiliki centering "${l.centering}" sehingga kontribusi atomnya menghasilkan total ${n} atom efektif per unit cell.`,
      shuffle:true
    });
  });
  // APF / CN for cubic (well known, pedagogically standard)
  const cubicFacts = [
    {id:'cubic-P', cn:6, apf:'0.52'},
    {id:'cubic-I', cn:8, apf:'0.68'},
    {id:'cubic-F', cn:12, apf:'0.74'}
  ];
  cubicFacts.forEach(f=>{
    const lat = getLattice(f.id);
    bank.push({
      q:`Berapa Coordination Number (CN) untuk struktur ${lat.label}?`,
      options:['4','6','8','12'], correct:String(f.cn),
      explain:`${lat.label} memiliki CN = ${f.cn}, dihitung dari jumlah titik kisi tetangga terdekat pada jarak minimum.`
    });
  });
  return bank;
}
