--------------------------------------------------------------------------------------- */

const mainContainer = document.getElementById('canvas3d');
const mainEngine = createEngine(mainContainer);
mainEngine.setView('iso');

let lastCalc = null;

function currentLattice(){ return getLattice(state.latticeId); }

function applyConstraints(){
  const c = SYSTEM_CONSTRAINTS[state.system];
  const p = state.params;
  if(c.b==='a') p.b = p.a; else if(typeof c.b==='number') p.b=c.b;
  if(c.c==='a') p.c = p.a; else if(typeof c.c==='number') p.c=c.c;
  if(c.alpha==='alpha'){} else if(typeof c.alpha==='number') p.alpha=c.alpha;
  if(c.beta==='alpha') p.beta = p.alpha; else if(typeof c.beta==='number') p.beta=c.beta;
  if(c.gamma==='alpha') p.gamma = p.alpha; else if(typeof c.gamma==='number') p.gamma=c.gamma;
}

function refreshSliderLocksAndValues(){
  const c = SYSTEM_CONSTRAINTS[state.system];
  const lockMap = {a:false, b:c.b!==false, c:c.c!==false, alpha:c.alpha!==false, beta:c.beta!==false, gamma:c.gamma!==false};
  ['a','b','c','alpha','beta','gamma'].forEach(k=>{
    const slider = document.getElementById('slider-'+k);
    const row = document.getElementById('row-'+k);
    slider.disabled = lockMap[k];
    row.classList.toggle('locked', lockMap[k]);
    slider.value = state.params[k];
    const unit = (k==='a'||k==='b'||k==='c') ? ' Å' : '°';
    document.getElementById('val-'+k).textContent = Number(state.params[k]).toFixed(2).replace(/\.00$/, '.00') + unit;
  });
}

function renderMain(){
  applyConstraints();
  const lat = currentLattice();
  lastCalc = buildScene(mainEngine, state.params, lat, {show:state.show, explode:state.explode, displayMode:state.displayMode, miller:{...state.miller, active: state.show.plane}});
  updateOverlay(lat);
  updateInfoPanels(lat, lastCalc);
  refreshSliderLocksAndValues();
}

