  document.getElementById('quizQuestion').innerHTML = `<pre>${q.q}</pre>`;

  let optionLabels;
  if(q.options[0] in CRYSTAL_SYSTEMS){
    optionLabels = q.options.map(k=>({key:k, label:CRYSTAL_SYSTEMS[k].name}));
  } else {
    optionLabels = q.options.map(k=>({key:k, label:k}));
  }
  optionLabels = shuffleArr(optionLabels);

  const optsDiv = document.getElementById('quizOpts');
  optsDiv.innerHTML='';
  optionLabels.forEach(opt=>{
    const btn = document.createElement('button');
    btn.className='quiz-opt';
    btn.textContent = opt.label;
    btn.addEventListener('click', ()=>answerQuiz(opt.key, btn));
    optsDiv.appendChild(btn);
  });
  updateQuizScoreLabel();
}

function answerQuiz(key, btn){
  const q = quizState.current;
  const correct = String(key)===String(q.correct);
  quizState.total++;
  if(correct) quizState.score++;
  document.querySelectorAll('.quiz-opt').forEach(b=>{
    b.disabled = true;
    const isThisCorrect = (b===btn);
    if(isThisCorrect) b.classList.add(correct?'correct':'wrong');
  });
  const explainDiv = document.getElementById('quizExplain');
  explainDiv.textContent = (correct? '✓ Benar! ' : '✗ Kurang tepat. ') + q.explain;
  explainDiv.classList.add('show');
  updateQuizScoreLabel();
}
function updateQuizScoreLabel(){
  document.getElementById('quizScore').textContent = `Skor: ${quizState.score} / ${quizState.total}`;
}

/* ---------------------------------------------------------------------------------------
   10. BOOT
--------------------------------------------------------------------------------------- */
loadLatticeDefaults();
renderMain();

})();
</script>
