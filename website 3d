  renderCalcSteps(lat, calc);
}

function renderCalcSteps(lat, calc){
  const parts = [];
  const weightLabel = {corner:'1/8 (sudut)', face:'1/2 (muka)', body:'1 (badan)', base:'1/2 (basis)'};
  const grouped = {};
  calc.atoms.forEach(a=>{ grouped[a.role]=(grouped[a.role]||0)+1; });
  Object.keys(grouped).forEach(role=>{
    const w = {corner:1/8, face:1/2, body:1, base:1/2}[role];
    parts.push(`${grouped[role]} × ${weightLabel[role]} = <span class="eq">${(grouped[role]*w).toFixed(3).replace(/0+$/,'').replace(/\.$/,'')}</span>`);
  });
  const total = parts.length? calc.nEff : 0;
  document.getElementById('calcSteps').innerHTML =
    `<div><b>Kontribusi atom — ${lat.label}</b></div>` +
    parts.map(p=>`<div>${p}</div>`).join('') +
    `<div style="margin-top:6px;border-top:1px solid var(--border-soft);padding-top:6px;">Total atom efektif = <span class="eq">${calc.nEff}</span> atom/unit cell</div>` +
    `<div style="margin-top:10px;"><b>Volume</b></div>` +
    `<div>V = abc·√(1+2cosα·cosβ·cosγ − cos²α−cos²β−cos²γ)</div>` +
    `<div>V = <span class="eq">${fmt(calc.V,3)} Å³</span></div>` +
    `<div style="margin-top:10px;"><b>Atomic Packing Factor</b></div>` +
    `<div>r = d_min / 2 = <span class="eq">${fmt(calc.r,3)} Å</span></div>` +
    `<div>APF = (n × 4/3·π·r³) / V = <span class="eq">${fmt(calc.apf,4)}</span></div>`;
}

