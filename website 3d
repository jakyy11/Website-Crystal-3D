<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>CrystalSim 3D — Interactive Bravais Lattice Simulation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* =========================================================
   CRYSTALSIM 3D — DESIGN TOKENS
   Palette: instrument-panel dark (graphite/void) + amber LCD
   readout accent + cool teal data accent.
   Display: Space Grotesk / Body: Inter / Data: JetBrains Mono
========================================================= */
:root{
  --void:#0a0e13;
  --panel:#11161d;
  --panel-alt:#161d26;
  --panel-raised:#1b232e;
  --border:#26313e;
  --border-soft:#1c2530;
  --text-1:#e9eef3;
  --text-2:#9fb0bf;
  --text-3:#6b7c8c;
  --amber:#ffb454;
  --amber-dim:#8a5c22;
  --teal:#5ecbd8;
  --teal-dim:#2a5a61;
  --red:#ff6b6b;
  --green:#7ee0a8;
  --violet:#c7a3ff;
  --corner-color:#5ecbd8;
  --face-color:#ffb454;
  --body-color:#ff8fb1;
  --base-color:#c7a3ff;
  --font-display:'Space Grotesk',sans-serif;
  --font-body:'Inter',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
  --radius:6px;
  --header-h:88px;
}
*{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0;
  background:var(--void);
  color:var(--text-1);
  font-family:var(--font-body);
  overflow:hidden;
}
::-webkit-scrollbar{width:8px;height:8px;}
::-webkit-scrollbar-track{background:var(--panel);}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px;}
::-webkit-scrollbar-thumb:hover{background:var(--text-3);}

button{font-family:var(--font-body);cursor:pointer;}
input[type=number]{font-family:var(--font-mono);}
select{font-family:var(--font-body);}

/* ---------- App shell ---------- */
#app{display:flex;flex-direction:column;height:100vh;width:100vw;}

/* ---------- Header ---------- */
#header{
  height:var(--header-h);
  min-height:var(--header-h);
  display:flex;align-items:center;
  justify-content:space-between;
  padding:0 18px;
  background:linear-gradient(180deg,var(--panel-raised),var(--panel));
  border-bottom:1px solid var(--border);
  gap:16px;
  position:relative;
  z-index:50;
}
.brand{display:flex;align-items:center;gap:12px;}
.brand-mark{
  width:42px;height:42px;border:1px solid var(--teal-dim);border-radius:8px;
  display:flex;align-items:center;justify-content:center;position:relative;
  background:radial-gradient(circle at 30% 30%,#1a2733,#0d1319);
  flex:none;
}
.brand-mark svg{width:26px;height:26px;}
.brand-text h1{
  font-family:var(--font-display);
  font-size:19px;font-weight:700;letter-spacing:0.5px;margin:0;
  color:var(--text-1);
}
.brand-text h1 span{color:var(--amber);}
.brand-text p{margin:1px 0 0;font-size:11px;color:var(--text-3);letter-spacing:1px;text-transform:uppercase;font-family:var(--font-mono);}
.dev-info{
  display:flex;flex-direction:column;align-items:flex-end;
  font-family:var(--font-mono);font-size:10.5px;line-height:1.55;color:var(--text-3);
  border-right:1px solid var(--border-soft);padding-right:16px;margin-right:2px;
}
.dev-info b{color:var(--teal);font-weight:600;}
.header-actions{display:flex;gap:8px;align-items:center;flex:none;}
.btn{
  background:var(--panel-alt);border:1px solid var(--border);color:var(--text-1);
  padding:8px 12px;border-radius:var(--radius);font-size:12.5px;font-weight:500;
  display:flex;align-items:center;gap:6px;transition:.15s;white-space:nowrap;
}
.btn:hover{border-color:var(--teal-dim);color:var(--teal);background:var(--panel-raised);}
.btn.amber:hover{border-color:var(--amber-dim);color:var(--amber);}
.btn.primary{background:var(--amber);color:#1a1206;border-color:var(--amber);font-weight:600;}
.btn.primary:hover{background:#ffc478;color:#1a1206;}
.btn.small{padding:5px 9px;font-size:11px;}
.btn:disabled{opacity:.35;cursor:not-allowed;}
.icon-btn{width:34px;height:34px;padding:0;justify-content:center;display:none;}

/* ---------- Layout ---------- */
#main-layout{
  flex:1;display:grid;
  grid-template-columns:296px 1fr 320px;
  min-height:0;
}
.panel-col{
  background:var(--panel);
  border-right:1px solid var(--border);
  overflow-y:auto;overflow-x:hidden;
  padding:14px 14px 40px;
  display:flex;flex-direction:column;gap:14px;
}
#info-panel{border-right:none;border-left:1px solid var(--border);}

.section{
  background:var(--panel-alt);
  border:1px solid var(--border-soft);
  border-radius:8px;
  padding:12px 13px 14px;
}
.section-title{
  font-family:var(--font-display);
  font-size:12px;font-weight:600;letter-spacing:1px;text-transform:uppercase;
  color:var(--teal);margin:0 0 10px;display:flex;align-items:center;justify-content:space-between;
}
.section-title small{color:var(--text-3);font-family:var(--font-mono);font-weight:400;letter-spacing:0;font-size:10px;text-transform:none;}

label.field-label{
  display:block;font-size:11px;color:var(--text-2);margin-bottom:5px;
  font-family:var(--font-mono);letter-spacing:.3px;
}
select.control-select{
  width:100%;background:var(--panel-raised);color:var(--text-1);
  border:1px solid var(--border);border-radius:5px;padding:9px 10px;font-size:13px;
  outline:none;margin-bottom:10px;
}
select.control-select:focus{border-color:var(--teal);}

/* slider rows */
.slider-row{margin-bottom:12px;}
.slider-row:last-child{margin-bottom:2px;}
.slider-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;}
.slider-head .name{font-size:12.5px;color:var(--text-2);font-family:var(--font-mono);}
.slider-head .val{font-size:13px;color:var(--amber);font-family:var(--font-mono);font-weight:600;min-width:60px;text-align:right;}
.slider-row.locked .slider-head .name{color:var(--text-3);}
.slider-row.locked .slider-head .val{color:var(--text-3);}
input[type=range]{
  width:100%;height:4px;border-radius:2px;background:var(--border);
  -webkit-appearance:none;appearance:none;outline:none;cursor:pointer;
}
input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;width:15px;height:15px;border-radius:50%;
  background:var(--teal);border:2px solid #0a0e13;cursor:pointer;
  box-shadow:0 0 0 2px var(--teal-dim);
}
input[type=range]:disabled{opacity:.3;cursor:not-allowed;}
input[type=range]:disabled::-webkit-slider-thumb{background:var(--text-3);box-shadow:none;}
input[type=range].angle::-webkit-slider-thumb{background:var(--amber);box-shadow:0 0 0 2px var(--amber-dim);}
input[type=range]::-moz-range-thumb{width:15px;height:15px;border-radius:50%;background:var(--teal);border:2px solid #0a0e13;}

.hint{font-size:10.5px;color:var(--text-3);margin-top:8px;line-height:1.5;font-family:var(--font-mono);}

/* checkbox list */
.chk-row{display:flex;align-items:center;gap:8px;padding:5px 0;font-size:12.5px;color:var(--text-2);}
.chk-row input{accent-color:var(--teal);width:14px;height:14px;}
.chk-row label{cursor:pointer;user-select:none;flex:1;}

.btn-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;}
.btn-grid.three{grid-template-columns:1fr 1fr 1fr;}
.btn-grid .btn{justify-content:center;width:100%;}

/* readout / data displays (signature element) */
.readout{
  background:#05070a;
  border:1px solid var(--border);
  border-radius:6px;
  padding:10px 12px;
  font-family:var(--font-mono);
  position:relative;
  overflow:hidden;
}
.readout::before{
  content:"";position:absolute;inset:0;
  background:repeating-linear-gradient(180deg,rgba(255,255,255,.015) 0px,rgba(255,255,255,.015) 1px,transparent 1px,transparent 3px);
  pointer-events:none;
}
.readout-row{display:flex;justify-content:space-between;align-items:baseline;padding:3px 0;font-size:12px;border-bottom:1px dashed var(--border-soft);}
.readout-row:last-child{border-bottom:none;}
.readout-row .k{color:var(--text-3);letter-spacing:.4px;}
.readout-row .v{color:var(--amber);font-weight:600;text-shadow:0 0 8px rgba(255,180,84,.35);}
.readout-row .v.teal{color:var(--teal);text-shadow:0 0 8px rgba(94,203,216,.35);}

.calc-toggle{
  width:100%;background:none;border:1px dashed var(--border);color:var(--teal);
  padding:8px 10px;border-radius:5px;font-size:12px;font-family:var(--font-mono);
  margin-top:10px;text-align:left;
}
.calc-steps{
  display:none;margin-top:8px;background:#05070a;border:1px solid var(--border-soft);
  border-radius:5px;padding:10px 12px;font-family:var(--font-mono);font-size:12px;color:var(--text-2);line-height:1.9;
}
.calc-steps.open{display:block;}
.calc-steps .eq{color:var(--green);}

.legend-tag{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--text-2);padding:3px 0;}
.legend-dot{width:10px;height:10px;border-radius:50%;flex:none;}

/* ---------- Viewport ---------- */
#viewport-container{
  position:relative;background:radial-gradient(ellipse at center, #0e141c 0%, #060a0e 100%);
  overflow:hidden;
}
#canvas3d{position:absolute;inset:0;}
#canvas3d canvas{display:block;}

.reticle{position:absolute;pointer-events:none;width:28px;height:28px;opacity:.55;z-index:5;}
.reticle svg{width:100%;height:100%;}
.reticle.tl{top:12px;left:12px;}
.reticle.tr{top:12px;right:12px;transform:scaleX(-1);}
.reticle.bl{bottom:12px;left:12px;transform:scaleY(-1);}
.reticle.br{bottom:12px;right:12px;transform:scale(-1,-1);}

.viewport-overlay-top{
  position:absolute;top:14px;left:50%;transform:translateX(-50%);
  text-align:center;z-index:6;pointer-events:none;
}
.viewport-overlay-top .sys-name{font-family:var(--font-display);font-size:20px;font-weight:700;color:var(--text-1);letter-spacing:.5px;text-shadow:0 2px 12px rgba(0,0,0,.8);}
.viewport-overlay-top .lat-name{font-family:var(--font-mono);font-size:11.5px;color:var(--teal);letter-spacing:1px;margin-top:2px;text-shadow:0 2px 8px rgba(0,0,0,.8);}

.view-controls{
  position:absolute;bottom:16px;left:50%;transform:translateX(-50%);
  display:flex;gap:6px;background:rgba(17,22,29,.85);backdrop-filter:blur(6px);
  border:1px solid var(--border);border-radius:8px;padding:6px;z-index:6;
}
.view-controls .btn{padding:6px 10px;font-size:11px;}

.explode-bar{
  position:absolute;top:14px;right:16px;z-index:6;
  background:rgba(17,22,29,.85);backdrop-filter:blur(6px);
  border:1px solid var(--border);border-radius:8px;padding:9px 12px;width:190px;
}
.explode-bar label{font-size:10.5px;color:var(--text-2);font-family:var(--font-mono);display:flex;justify-content:space-between;margin-bottom:5px;}
.explode-bar label span{color:var(--amber);}

.legend-box{
  position:absolute;bottom:16px;left:16px;z-index:6;
  background:rgba(17,22,29,.85);backdrop-filter:blur(6px);
  border:1px solid var(--border);border-radius:8px;padding:10px 13px;
  min-width:150px;
}
.legend-box .lt{font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;font-family:var(--font-mono);}

.css2d-label{
  font-family:var(--font-mono);font-size:10px;color:var(--text-1);
  background:rgba(10,14,19,.75);padding:1px 5px;border-radius:3px;
  border:1px solid var(--border-soft);white-space:nowrap;pointer-events:none;
}
.css2d-label.axis{color:var(--amber);border-color:var(--amber-dim);font-weight:600;}
.css2d-label.vec{color:var(--teal);border-color:var(--teal-dim);font-weight:600;}

/* ---------- Modals ---------- */
.modal-backdrop{
  position:fixed;inset:0;background:rgba(4,6,9,.72);backdrop-filter:blur(3px);
  display:none;align-items:center;justify-content:center;z-index:200;padding:20px;
}
.modal-backdrop.open{display:flex;}
.modal{
  background:var(--panel);border:1px solid var(--border);border-radius:12px;
  max-width:820px;width:100%;max-height:88vh;overflow-y:auto;
  box-shadow:0 30px 80px rgba(0,0,0,.6);
}
.modal-head{
  display:flex;justify-content:space-between;align-items:center;
  padding:16px 20px;border-bottom:1px solid var(--border);position:sticky;top:0;
  background:var(--panel);z-index:2;
}
.modal-head h2{font-family:var(--font-display);font-size:17px;margin:0;color:var(--text-1);}
.modal-body{padding:20px;}
.modal-close{background:none;border:1px solid var(--border);color:var(--text-2);width:30px;height:30px;border-radius:6px;font-size:16px;line-height:1;}
.modal-close:hover{color:var(--red);border-color:var(--red);}

/* about modal */
.about-dev{background:var(--panel-alt);border:1px solid var(--border-soft);border-radius:8px;padding:16px;margin-top:14px;font-family:var(--font-mono);font-size:13px;line-height:2;}
.about-dev b{color:var(--teal);}

/* compare */
.compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px;}
.compare-pick{display:flex;flex-direction:column;gap:8px;}
.compare-canvas-wrap{height:260px;background:#05070a;border:1px solid var(--border-soft);border-radius:8px;position:relative;overflow:hidden;}
.compare-canvas-wrap canvas{width:100%!important;height:100%!important;}
table.cmp-table{width:100%;border-collapse:collapse;margin-top:16px;font-family:var(--font-mono);font-size:12.5px;}
table.cmp-table th, table.cmp-table td{border:1px solid var(--border-soft);padding:8px 10px;text-align:center;}
table.cmp-table th{background:var(--panel-alt);color:var(--teal);font-weight:600;}
table.cmp-table td.label{text-align:left;color:var(--text-2);background:var(--panel-alt);}

/* custom crystal */
.custom-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px;}
.custom-grid .field{display:flex;flex-direction:column;gap:4px;}
.custom-grid input[type=number]{
  background:var(--panel-raised);border:1px solid var(--border);color:var(--text-1);
  padding:8px 9px;border-radius:5px;font-size:13px;width:100%;
}
.result-banner{margin-top:16px;padding:12px 14px;border-radius:8px;font-family:var(--font-mono);font-size:13px;display:none;}
.result-banner.ok{display:block;background:rgba(126,224,168,.08);border:1px solid var(--green);color:var(--green);}
.result-banner.warn{display:block;background:rgba(255,107,107,.08);border:1px solid var(--red);color:var(--red);}

/* quiz */
.quiz-score{font-family:var(--font-mono);font-size:13px;color:var(--amber);margin-bottom:10px;}
.quiz-q{font-size:15px;line-height:1.6;margin-bottom:14px;font-family:var(--font-body);}
.quiz-q pre{background:#05070a;border:1px solid var(--border-soft);padding:10px;border-radius:6px;font-family:var(--font-mono);font-size:12.5px;color:var(--teal);}
.quiz-opts{display:flex;flex-direction:column;gap:8px;}
.quiz-opt{
  text-align:left;background:var(--panel-alt);border:1px solid var(--border);color:var(--text-1);
  padding:10px 13px;border-radius:7px;font-size:13.5px;
}
.quiz-opt:hover{border-color:var(--teal);}
.quiz-opt.correct{border-color:var(--green);background:rgba(126,224,168,.1);color:var(--green);}
.quiz-opt.wrong{border-color:var(--red);background:rgba(255,107,107,.1);color:var(--red);}
.quiz-opt:disabled{cursor:default;}
.quiz-explain{margin-top:12px;padding:12px;background:var(--panel-alt);border-radius:7px;border:1px solid var(--border-soft);font-size:13px;color:var(--text-2);display:none;}
.quiz-explain.show{display:block;}

/* toast */
#toast{
  position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);
  background:var(--panel-raised);border:1px solid var(--teal-dim);color:var(--text-1);
  padding:10px 18px;border-radius:8px;font-size:13px;font-family:var(--font-mono);
  z-index:400;opacity:0;transition:.25s;pointer-events:none;
}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* theory panel */
.theory-row{display:flex;justify-content:space-between;padding:4px 0;font-size:12px;border-bottom:1px dashed var(--border-soft);}
.theory-row .k{color:var(--text-3);}
.theory-row .v{color:var(--text-1);font-family:var(--font-mono);}
.theory-desc{margin-top:8px;font-size:12px;color:var(--text-2);line-height:1.6;}
.bravais-chips{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;}
.bravais-chip{background:var(--panel-raised);border:1px solid var(--border);color:var(--teal);padding:3px 8px;border-radius:20px;font-size:11px;font-family:var(--font-mono);}

/* ---------- Mobile / Responsive ---------- */
.mobile-only{display:none;}
@media (max-width: 1100px){
  #main-layout{grid-template-columns:1fr;}
  .panel-col{
    position:fixed;top:var(--header-h);bottom:0;width:min(320px,86vw);
    z-index:100;transition:transform .25s ease;box-shadow:0 0 40px rgba(0,0,0,.5);
  }
  #sidebar{left:0;transform:translateX(-105%);}
  #sidebar.open{transform:translateX(0);}
  #info-panel{right:0;transform:translateX(105%);border-left:1px solid var(--border);}
  #info-panel.open{transform:translateX(0);}
  .icon-btn{display:flex;}
  .dev-info{display:none;}
  .brand-text p{display:none;}
  #viewport-container{grid-column:1/2;}
}
@media (max-width: 640px){
  .brand-text h1{font-size:15px;}
  #header{padding:0 10px;gap:8px;}
  .btn span.lbl{display:none;}
  .view-controls{max-width:94vw;overflow-x:auto;}
  .compare-grid{grid-template-columns:1fr;}
  .custom-grid{grid-template-columns:1fr 1fr;}
  .explode-bar{width:150px;}
}
</style>
</head>
<body>
<div id="app">

  <!-- ===================== HEADER ===================== -->
  <header id="header">
    <div style="display:flex;align-items:center;gap:14px;min-width:0;">
      <button class="btn icon-btn mobile-only" id="btnSidebarToggle" title="Kontrol">☰</button>
      <div class="brand">
        <div class="brand-mark">
          <svg viewBox="0 0 40 40" fill="none"><path d="M20 4 L34 12 V28 L20 36 L6 28 V12 Z" stroke="#5ecbd8" stroke-width="1.6"/><path d="M20 4 V20 M20 20 L34 12 M20 20 L6 12 M20 20 V36" stroke="#ffb454" stroke-width="1.2"/><circle cx="20" cy="4" r="2.2" fill="#5ecbd8"/><circle cx="34" cy="12" r="2.2" fill="#5ecbd8"/><circle cx="6" cy="12" r="2.2" fill="#5ecbd8"/><circle cx="20" cy="20" r="2.4" fill="#ffb454"/><circle cx="34" cy="28" r="2.2" fill="#5ecbd8"/><circle cx="6" cy="28" r="2.2" fill="#5ecbd8"/><circle cx="20" cy="36" r="2.2" fill="#5ecbd8"/></svg>
        </div>
        <div class="brand-text">
          <h1>CRYSTAL<span>SIM</span> 3D</h1>
          <p>Interactive Bravais Lattice Simulation</p>
        </div>
      </div>
    </div>
    <div class="dev-info">
      <div>Developed by <b>Ainuzzaim Azzaki</b></div>
      <div>NIM: <b>240321601033</b></div>
      <div>Program Studi Pendidikan Fisika</div>
    </div>
    <div class="header-actions">
      <button class="btn" id="btnReset" title="Reset simulasi"><span>⟲</span><span class="lbl">Reset</span></button>
      <button class="btn" id="btnFullscreen" title="Fullscreen"><span>⛶</span><span class="lbl">Fullscreen</span></button>
      <button class="btn" id="btnHelp" title="Tentang aplikasi"><span>ℹ</span><span class="lbl">About</span></button>
      <button class="btn icon-btn mobile-only" id="btnInfoToggle" title="Info & Perhitungan">📊</button>
    </div>
  </header>

  <!-- ===================== MAIN LAYOUT ===================== -->
  <div id="main-layout">

    <!-- ---------- SIDEBAR: CONTROLS ---------- -->
    <aside class="panel-col" id="sidebar">

      <div class="section">
        <div class="section-title">1 · Sistem Kristal</div>
        <label class="field-label">Pilih sistem kristal</label>
        <select id="selSystem" class="control-select"></select>
        <label class="field-label">Jenis Kisi Bravais</label>
        <select id="selLattice" class="control-select"></select>
      </div>

      <div class="section">
        <div class="section-title">2 · Parameter Panjang Kisi</div>
        <div class="slider-row" id="row-a">
          <div class="slider-head"><span class="name">a (Å)</span><span class="val" id="val-a">3.00 Å</span></div>
          <input type="range" id="slider-a" min="2" max="8" step="0.05" value="3">
        </div>
        <div class="slider-row" id="row-b">
          <div class="slider-head"><span class="name">b (Å)</span><span class="val" id="val-b">3.00 Å</span></div>
          <input type="range" id="slider-b" min="2" max="8" step="0.05" value="3">
