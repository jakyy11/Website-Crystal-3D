function classifySystem(a,b,c,alpha,beta,gamma){
  const eps = 0.02, epsA = 0.3;
  const eq = (x,y)=>Math.abs(x-y)<eps*Math.max(x,y,1);
  const eqA = (x,y)=>Math.abs(x-y)<epsA;
  const is90 = x=>eqA(x,90);
  const abcAllEq = eq(a,b)&&eq(b,c);
  const abcNoneEq = !eq(a,b)&&!eq(b,c)&&!eq(a,c);
  const angAll90 = is90(alpha)&&is90(beta)&&is90(gamma);
  const angAllEq = eqA(alpha,beta)&&eqA(beta,gamma);

  if(abcAllEq && angAll90) return 'cubic';
  if(eq(a,b) && !eq(b,c) && angAll90) return 'tetragonal';
  if(abcNoneEq && angAll90) return 'orthorhombic';
  if(abcNoneEq && is90(alpha) && is90(gamma) && !is90(beta)) return 'monoclinic';
  if(abcAllEq && angAllEq && !is90(alpha)) return 'rhombohedral';
  if(eq(a,b) && !eq(b,c) && is90(alpha) && is90(beta) && eqA(gamma,120)) return 'hexagonal';
  if(abcNoneEq && !is90(alpha) && !is90(beta) && !is90(gamma) && !eqA(alpha,beta) ) return 'triclinic';
  return 'triclinic'; // fallback: freest system for anything unmatched
}

